# 本檔僅供本機參考。實際請 `cp .env.example .env` 後填入下列三個值。

# ── LINE Messaging API（3 個值）──────────────────────────────────────────
# 從 https://developers.line.biz/console/ 拿（用既有的 LINE Official Account 即可）：
#   Basic settings  分頁 → Channel ID
#   Basic settings  分頁 → Channel secret
#   Messaging API   分頁 → Channel access token (long-lived) → Issue（僅當 refresh fallback）
# 同頁記得設定：Auto-reply = OFF、Webhooks = ON、Allow bot to join group chats = ON
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Gemini（1 個值，免費）─────────────────────────────────────────────────
# 從 https://aistudio.google.com/app/apikey 按 Create API key 拿
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Claude（optional：主回覆優先使用，額度/點數用完後自動切 Gemini）──
# 從 Anthropic Console 建立 API key；不要把真實 key 寫進 git。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Claude 429/credits/billing gate 的重試間隔（秒）
CLAUDE_QUOTA_COOLDOWN_SEC=3600
# 單次 Claude HTTP request timeout，避免拖過 LINE reply token
CLAUDE_REQUEST_TIMEOUT_SEC=20
CLAUDE_CLI_TIMEOUT_SEC=60
# Optional: use the logged-in `claude -p` account session directly.
# Normally the bot auto-switches to this when API billing has no balance.
CLAUDE_USE_CLI=false

# ── Groq（1 個值，免費，Gemini quota 爆時的雲端 fallback）─────────────────
# 從 https://console.groq.com/keys 拿（30 RPM / 14400 RPD）
# 用 llama-3.3-70b-versatile，比本機 3B 強很多
GROQ_API_KEY=  # https://console.groq.com/keys

# ── SQLite（本地檔案路徑，相對於 line_bot/，不改也行）──────────────────
SQLITE_PATH=line_bot.db

# ── 鎖定單一群組（Q6=B）──────────────────────────────────────────────────
# 空字串 = 尚未鎖定，此時 bot 只會 log 收到的 group_id 給你抓
# 抓到後填進這裡再重啟
# food_push / event_reminder 優先讀 FAMILY_GROUP_ID，未設則 fallback 下方 ALLOWED_GROUP_ID
FAMILY_GROUP_ID=
ALLOWED_GROUP_ID=

# ── Bot 行為 ──────────────────────────────────────────────────────────────
CONTEXT_ROUNDS=15
FACT_EXTRACT_EVERY=10
MAX_FACTS_IN_PROMPT=20

# ── Modal LoRA fine-tune（雲端訓練）────────────────────────────────────────
# Modal 認證**不**走 .env：請另外在 terminal 跑 `modal token new`（browser auth）
# 下面只在 fine-tune base model 是 gated repo（Llama 3 / Mistral 等）才需要
HUGGINGFACE_TOKEN=

# ── Together AI 雲端 vision fallback（本機 Qwen2.5-VL-7B 失敗時打雲端）──
# 隱私 trade-off：圖片內容會離開 Mac 給 Together AI 處理（已用 Gemini 處理過所有訊息，影響相對小）
# 從 https://api.together.xyz/settings/api-keys 拿
TOGETHER_API_KEY=
# 預設 false（保守）；要啟用 cloud fallback 改成 true
VISION_CLOUD_ENABLED=false
# 月度預算上限（USD），超過自動拒打
VISION_CLOUD_MONTHLY_BUDGET=5.0
# Together vision 模型（Qwen-VL 家族最經濟，預設 Qwen3-VL-8B-Instruct）
TOGETHER_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ── HTTP job dispatcher (n8n / external scheduler) ──────────────────────
# Master HMAC secret. Per-job token = HMAC-SHA256(JOBS_MASTER_TOKEN, job_name).
# 32+ random hex chars. Generate via: openssl rand -hex 32
JOBS_MASTER_TOKEN=
# Set to 1 to enable /jobs/* endpoints (off by default)
JOBS_ROUTES_ENABLED=0
