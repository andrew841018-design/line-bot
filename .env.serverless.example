# Copy these into Cloud Run environment variables or Secret Manager.
# Do not put real secrets in this file.

# Required LINE Messaging API values
TZ=Asia/Taipei
LINE_BOT_DISABLE_DOTENV=1
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Required LLM value
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite

# Optional cloud fallback
GROQ_API_KEY=

# Keep muted for first deploy. Flip to false only after /health and LINE webhook
# test pass and the old Mac tunnel/VM target is no longer handling the same channel.
BOT_MUTED=true

# Group gates
ALLOWED_GROUP_IDS=
FAMILY_GROUP_ID=

# Cloud Run filesystem is ephemeral. /tmp is explicit so tests and startup don't
# pretend the image filesystem is durable.
SQLITE_PATH=/tmp/line_bot.db

# Avoid local model preload on serverless cold starts.
LOCAL_LLM_PREWARM_DISABLED=1
VISION_CLOUD_ENABLED=false

# Public URL after deploy, without trailing slash. Example:
# https://line-bot-xxxxx-uc.a.run.app
LINE_BOT_PUBLIC_BASE_URL=

# HTTP jobs are off for phase 1. Enable only after reviewing SERVERLESS_CLOUD_RUN.md.
JOBS_ROUTES_ENABLED=0
JOBS_ALLOW_PUBLIC_HTTP=0
JOBS_SUBPROCESS_INHERIT_ENV=1
JOBS_MASTER_TOKEN=
LINE_BOT_JOB_STATE_DIR=/tmp/line-bot/state
LINE_BOT_JOB_LOG_DIR=/tmp/line-bot/logs/jobs
LINE_BOT_JOB_LOCK_DIR=/tmp/line-bot/locks
