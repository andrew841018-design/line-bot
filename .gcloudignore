# Cloud Run source deploy upload guard.
# Keep this stricter than .dockerignore because gcloud uploads files before the
# container build starts.

.gcloudignore
.git
.gitignore
.DS_Store
__pycache__/
*.py[cod]
*.pyo

.env
.env.*
!.env.example
!.env.serverless.example

.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.json
cov_annotated/

*.log
logs/
locks/
state/
.drain_locks/
pending_media/

line_bot.db
line_bot.db-*
*.sqlite
*.sqlite-*
*.bak
*.bak.*
*.enc

gemini_usage.json
quota_state.json
alert_state.json
health_monitor_state.json
ptt_pipeline_health_state.json
pending_explicit_reply.json
pending_explicit_reply.json.bak*
pending_feedback.json
event_reminder_private.json
pushed_jobs.json
suggestion_history.json
line_token_cache.json
pending_line_push.txt
pending_dlq.jsonl
quote_history.json
soxl_health_state.json
cramer_history.json
dynamic_quotes.json
feedback_state.json
user_aliases.json

finetune/data/*.json
finetune/data/*.jsonl
finetune/data/*.parquet
finetune/data/*.db
finetune/data/*.enc
finetune/adapters/
finetune/eval_results/

review_summary.md
